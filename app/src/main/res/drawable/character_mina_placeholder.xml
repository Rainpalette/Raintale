<!--
    米娜的占位立绘：伞下剪影（自绘 vector，零版权负担）。
    低饱和蓝灰 + 一点暖橙围巾 = worldview.md §4 的配色（灰雨 + 一束暖）。
    刻意画成剪影：占位不冒充正式立绘。正式立绘就绪后替换 Character.kt 的 idle 即可。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="180dp"
    android:viewportWidth="120"
    android:viewportHeight="180">

    <!-- 伞杆（先画，藏在头身后面） -->
    <path
        android:strokeColor="#90A4AE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M60,52 L60,148" />

    <!-- 伞尖 -->
    <path
        android:strokeColor="#90A4AE"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M60,8 L60,16" />

    <!-- 透明伞面（低透明度填充 + 浅描边 = 玻璃感），下缘三个波浪 -->
    <path
        android:fillColor="#B3E5FC"
        android:fillAlpha="0.28"
        android:strokeColor="#B0BEC5"
        android:strokeWidth="2"
        android:pathData="M60,16 C34,16 18,34 18,52 Q32,44 46,52 Q60,44 74,52 Q88,44 102,52 C102,34 86,16 60,16 Z" />

    <!-- 伞骨（两根，半透明） -->
    <path
        android:strokeColor="#B0BEC5"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.6"
        android:fillColor="#00000000"
        android:pathData="M60,16 L46,52 M60,16 L74,52" />

    <!-- 头（剪影） -->
    <path
        android:fillColor="#546E7A"
        android:pathData="M60,62 a10,10 0 1,1 -0.01,0 Z" />

    <!-- 身体：A 字大衣剪影 -->
    <path
        android:fillColor="#546E7A"
        android:pathData="M46,96 Q60,88 74,96 L82,148 Q60,156 38,148 Z" />

    <!-- 腿（略深一档） -->
    <path
        android:fillColor="#455A64"
        android:pathData="M52,148 L52,168 L58,168 L58,150 Z M62,150 L62,168 L68,168 L68,148 Z" />

    <!-- 暖橙围巾：整张图唯一的暖色（站台灯的那一点暖） -->
    <path
        android:fillColor="#FFB74D"
        android:pathData="M51,90 Q60,96 69,90 L69,97 Q60,103 51,97 Z" />

</vector>
